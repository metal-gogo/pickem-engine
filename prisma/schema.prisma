generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  runtime             = "cloudflare"
  engineType          = "client"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

generator nodeClient {
  provider            = "prisma-client"
  output              = "../generated/prisma-node"
  runtime             = "nodejs"
  engineType          = "client"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum MatchStage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTERFINAL
  SEMIFINAL
  THIRD_PLACE
  FINAL
}

enum PoolParticipantRole {
  OWNER
  MEMBER
}

model AppUser {
  id                 String            @id @default(cuid())
  authProvider       String
  authProviderUserId String
  displayName        String?
  email              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  ownedPools         Pool[]            @relation("PoolOwner")
  poolParticipants   PoolParticipant[]

  @@unique([authProvider, authProviderUserId])
  @@map("users")
}

model Tournament {
  id              String            @id
  slug            String            @unique
  name            String
  officialName    String?
  startsOn        DateTime          @db.Date
  endsOn          DateTime          @db.Date
  pickLockAt      DateTime?
  hostCountries   String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  groups          TournamentGroup[]
  matches         Match[]
  pools           Pool[]
  tournamentTeams TournamentTeam[]

  @@map("tournaments")
}

model TournamentGroup {
  id              String           @id
  tournamentId    String
  code            String
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tournament      Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches         Match[]
  tournamentTeams TournamentTeam[]

  @@unique([tournamentId, code])
  @@index([tournamentId])
  @@map("tournament_groups")
}

model Team {
  id              String           @id
  fifaCode        String           @unique
  name            String
  normalizedName  String?
  confederation   String
  continent       String
  flagEmoji       String?
  accentColors    String[]         @default([])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  awayMatches     Match[]          @relation("AwayTeamMatches")
  homeMatches     Match[]          @relation("HomeTeamMatches")
  tournamentTeams TournamentTeam[]

  @@map("teams")
}

model TournamentTeam {
  id                            String           @id @default(cuid())
  tournamentId                  String
  teamId                        String
  groupId                       String?
  groupSeedOrder                Int?
  isHost                        Boolean          @default(false)
  fifaRanking                   Int?
  qualificationDate             DateTime?        @db.Date
  totalQualifications           Int?
  lastQualifiedYear             Int?
  currentConsecutiveAppearances Int?
  bestFinish                    String?
  bestFinishYears               Int[]            @default([])
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt
  group                         TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  team                          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournament                    Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@index([groupId])
  @@index([teamId])
  @@map("tournament_teams")
}

model Venue {
  id            String   @id
  city          String
  stadium       String
  country       String
  groundAliases String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  matches       Match[]

  @@map("venues")
}

model Match {
  id                  String           @id
  tournamentId        String
  matchNumber         Int?
  stage               MatchStage
  roundLabel          String
  kickoffAt           DateTime
  venueId             String
  groupId             String?
  homeTeamId          String?
  awayTeamId          String?
  homeParticipantSlot Json?
  awayParticipantSlot Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  awayTeam            Team?            @relation("AwayTeamMatches", fields: [awayTeamId], references: [id], onDelete: Restrict)
  group               TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  homeTeam            Team?            @relation("HomeTeamMatches", fields: [homeTeamId], references: [id], onDelete: Restrict)
  result              MatchResult?
  picks               MatchPick[]
  tournament          Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  venue               Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, matchNumber])
  @@index([awayTeamId])
  @@index([groupId])
  @@index([homeTeamId])
  @@index([stage])
  @@index([tournamentId])
  @@map("matches")
}

model MatchResult {
  id             String   @id @default(cuid())
  matchId        String   @unique
  homeScore      Int
  awayScore      Int
  sourceLabel    String?
  sourceUrl      String?
  officializedAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_results")
}

model Pool {
  id              String               @id @default(cuid())
  tournamentId    String
  ownerUserId     String
  name            String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  owner           AppUser              @relation("PoolOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  participants    PoolParticipant[]
  scoringSettings PoolScoringSettings?
  tournament      Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Restrict)

  @@index([ownerUserId])
  @@index([tournamentId])
  @@map("pools")
}

model PoolParticipant {
  id        String              @id @default(cuid())
  poolId    String
  userId    String
  role      PoolParticipantRole @default(MEMBER)
  joinedAt  DateTime            @default(now())
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  picks     MatchPick[]
  pool      Pool                @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user      AppUser             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@index([userId])
  @@map("pool_participants")
}

model MatchPick {
  id                String          @id @default(cuid())
  poolParticipantId String
  matchId           String
  homeScore         Int
  awayScore         Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  match             Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  poolParticipant   PoolParticipant @relation(fields: [poolParticipantId], references: [id], onDelete: Cascade)

  @@unique([poolParticipantId, matchId])
  @@index([matchId])
  @@map("match_picks")
}

model PoolScoringSettings {
  id                      String   @id @default(cuid())
  poolId                  String   @unique
  winnerOrDrawPoints      Int
  exactResultBonusEnabled Boolean  @default(false)
  exactResultBonusPoints  Int?
  topScorerBonusEnabled   Boolean  @default(false)
  topScorerBonusPoints    Int?
  bestPlayerBonusEnabled  Boolean  @default(false)
  bestPlayerBonusPoints   Int?
  championBonusEnabled    Boolean  @default(false)
  championBonusPoints     Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  pool                    Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@map("pool_scoring_settings")
}
