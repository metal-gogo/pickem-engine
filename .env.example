# Copy this file to .env for local development.
# Do not commit real values. Local .env files are ignored by git.

# App
APP_ENV="local"
APP_BASE_URL="http://localhost:5173"
APP_SESSION_SECRET=""

# Database - Neon Postgres / Prisma.
# Use a non-production Neon branch for local development.
# If DATABASE_URL is pooled, set DIRECT_URL to the direct branch URL for migrations.
DATABASE_URL=""
DIRECT_URL=""

# Authentication - WorkOS AuthKit
WORKOS_CLIENT_ID=""
WORKOS_API_KEY=""
WORKOS_COOKIE_PASSWORD=""
WORKOS_REDIRECT_URI="http://localhost:5173/callback"
WORKOS_LOGOUT_REDIRECT_URI="http://localhost:5173/"

# Observability - Sentry
SENTRY_DSN=""
SENTRY_ENVIRONMENT="local"
SENTRY_RELEASE=""

# CI/deploy automation.
# Usually set in GitHub Actions, not required for normal local app startup.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
NEON_API_KEY=""
NEON_PROJECT_ID=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Optional social provider setup.
# Prefer configuring these in WorkOS/provider dashboards unless local testing needs them.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# Local agent/MCP tooling.
STITCH_GOOGLE_API_KEY=""
