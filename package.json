{
  "name": "pickem-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "tsc -b && react-router build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preview": "react-router-serve ./build/server/index.js",
    "security:audit": "pnpm audit",
    "security:audit:prod": "pnpm audit --prod",
    "security:audit:ci": "pnpm audit --audit-level high",
    "security:audit:ci:prod": "pnpm audit --prod --audit-level high",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "test": "vitest run --project=unit",
    "storybook": "storybook dev -p 6100",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook",
    "coverage-storybook": "vitest run --project=storybook --coverage"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@react-router/node": "^7.14.2",
    "@react-router/serve": "^7.14.2",
    "@workos-inc/authkit-react-router": "^0.10.0",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.14.2",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.4.2",
    "jsdom": "^29.0.2",
    "oxfmt": "^0.46.0",
    "playwright": "^1.59.1",
    "prisma": "^7.8.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.2"
}
