{
  "name": "pickem-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "react-router build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "pnpm run lint -- --fix",
    "prepare": "lefthook install",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "security:audit": "pnpm audit",
    "security:audit:prod": "pnpm audit --prod",
    "security:audit:ci": "pnpm audit --audit-level high",
    "security:audit:ci:prod": "pnpm audit --prod --audit-level high",
    "security:secrets": "scripts/gitleaks.sh detect --source . --redact --verbose",
    "security:secrets:staged": "scripts/gitleaks.sh protect --staged --redact --verbose",
    "db:generate": "prisma generate",
    "db:check": "pnpm run db:validate && pnpm run db:generate && pnpm run db:seed:check",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:pull": "prisma db pull",
    "db:seed": "prisma db seed",
    "db:seed:check": "tsx prisma/seed.ts --dry-run",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "worker:types": "wrangler types worker-configuration.d.ts --env-file=worker-configuration.env",
    "worker:types:check": "sh scripts/check-worker-types.sh",
    "typegen": "react-router typegen",
    "typecheck": "pnpm run typegen && pnpm run worker:types:check && pnpm run db:generate && tsc -b --pretty false",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --project=unit",
    "storybook": "storybook dev -p 6100",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook",
    "coverage-storybook": "vitest run --project=storybook --coverage",
    "verify": "pnpm run verify:format && pnpm run verify:lint && pnpm run verify:types && pnpm run verify:db && pnpm run verify:security && pnpm run verify:tests && pnpm run verify:storybook && pnpm run verify:build",
    "verify:format": "pnpm run fmt:check",
    "verify:lint": "pnpm run lint",
    "verify:types": "pnpm run typecheck",
    "verify:db": "pnpm run db:check",
    "verify:security": "pnpm run security:audit:ci && pnpm run security:audit:ci:prod && pnpm run security:secrets",
    "verify:tests": "pnpm run test",
    "verify:storybook": "pnpm run build-storybook && pnpm run test-storybook",
    "verify:build": "pnpm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-router/node": "^7.14.2",
    "@react-router/serve": "^7.14.2",
    "@workos-inc/authkit-react-router": "^0.10.0",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.2",
    "@react-router/dev": "^7.14.2",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.4.2",
    "jsdom": "^29.0.2",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "playwright": "^1.59.1",
    "prisma": "^7.8.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.13",
      "cookie": "0.7.2",
      "qs": "6.14.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "lefthook",
      "prisma"
    ]
  }
}
